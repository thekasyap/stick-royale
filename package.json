{
  "name": "stick-royale",
  "private": true,
  "version": "0.1.0",
  "description": "Lightweight stick-figure browser battle royale",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @stick-royale/web dev",
    "build": "pnpm --filter @stick-royale/shared build && pnpm --filter @stick-royale/sim build && pnpm --filter @stick-royale/web build",
    "build:shared": "pnpm --filter @stick-royale/shared build",
    "build:sim": "pnpm --filter @stick-royale/sim build",
    "dev:server": "pnpm --filter @stick-royale/server dev",
    "typecheck": "pnpm --filter @stick-royale/shared --filter @stick-royale/sim --filter @stick-royale/web --filter @stick-royale/server run typecheck",
    "smoke": "tsx packages/sim/scripts/smoke-match.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.23.1"
  }
}
